# Copy this file to .env and fill in real values.
# The service will refuse to start (see src/config/env.js) if any of the
# variables marked REQUIRED below are missing.

# --- Server ---
PORT=5000
# Public base URL of THIS service, used to build PalmPay's notifyUrl webhook
# callback (e.g. https://paymentgatewaybackend-580i.onrender.com)
BASE_URL=http://localhost:5000

# --- Database (REQUIRED) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Auth (REQUIRED) ---
# Secret used to sign/verify JWTs issued by src/controllers/auth.controller.js
# and checked by src/middleware/auth.middleware.js
JWT_SECRET=

# --- PalmPay OpenAPI (REQUIRED) ---
# Per PalmPay's documented conventions: Authorization header = "Bearer " +
# your AppId (i.e. PALMPAY_MERCHANT_ID below) — NOT a separate opaque token.
# Request body is signed with your RSA private key and sent in the
# `Signature` header. Still unconfirmed against PalmPay's own "signature
# method" doc page: whether the digest step is plain RSA-SHA1 (what's
# currently implemented in src/utils/rsaUtil.js) or an MD5-then-RSA-sign
# scheme, and the exact set of valid `productType` values for a hosted
# checkout page vs. wallet-balance payment.
PALMPAY_BASE_URL=https://open-gw-daily.palmpay-inc.com
# This IS the AppId sent as "Authorization: Bearer <this value>"
PALMPAY_MERCHANT_ID=
# Base64-encoded PKCS#8 RSA private key (yours), used to sign outgoing requests
PALMPAY_MERCHANT_PRIVATE_KEY=
# NOT currently used by src/services/palmpayService.js — PalmPay's docs show
# no separate bearer token concept, just AppId + RSA signature. Kept here in
# case another endpoint turns out to need it; delete if it doesn't.
PALMPAY_AUTH_TOKEN=
# Base64-encoded RSA public key PalmPay gives you, used to verify their webhook signatures
PALMPAY_PUBLIC_KEY=
# Only used by src/services/payout.service.js — verify this against PalmPay's
# actual payout/transfer endpoint auth scheme before relying on it in production.
PALMPAY_SECRET=

# --- Internal service-to-service auth ---
# Sent as X-Internal-Key when notifying the telemedicine backend
# (zhs-backend-1.onrender.com) that a payment succeeded so it can create the
# appointment. Must match whatever that backend expects.
INTERNAL_API_KEY=

# --- Background jobs (optional) ---
# If unset, the Bull-based payment queue/worker (src/jobs) is skipped at boot
# instead of crashing the whole API.
REDIS_HOST=
REDIS_PORT=6379
